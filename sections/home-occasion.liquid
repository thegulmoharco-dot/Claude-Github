{%- doc -%}
  Home "Shop by Budget" — the design-handoff rail (design_handoff_shop_by_budget/)
  with its colour and typography matched to the rest of the homepage. Layout,
  spacing and interaction are unchanged from the handoff; only the palette and
  fonts now come from the homepage's own design system (gulmohar-home-fonts:
  Cormorant Garamond via --gh-serif, Manrope via --gh-sans, oxblood --gh-burgundy,
  ivory --gh-bg-main, --gh-ink) so the section reads as native to the homepage
  rather than the handoff mockup's Newsreader + terracotta palette.

  A centered heading block (Cormorant heading + italic Cormorant lede) over a
  native horizontally-scrollable rail of four square price-tier tiles (image →
  1px burgundy rule → "Under" + amount → description → "Shop Now →" CTA). Each
  tile links to its price-filtered collection. Native scroll only, no JS.
{%- enddoc -%}

{%- liquid
  assign tiers = section.blocks | where: 'type', 'occasion'
-%}

<section class="gulmohar-home gb-shop-budget" aria-labelledby="gb-heading-{{ section.id }}">
  <div class="gb-head">
    {% if section.settings.heading != blank %}
      <h2 id="gb-heading-{{ section.id }}" class="gb-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="gb-sub">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="gb-rail">
    {% for block in tiers %}
      {%- liquid
        assign amount = block.settings.amount | strip
        assign tile_alt = block.settings.image.alt | default: 'Jewellery under ' | append: amount
      -%}
      <a
        class="gb-tile"
        href="{{ block.settings.link | default: '#' }}"
        aria-label="Shop jewellery under {{ amount | escape }}"
        {{ block.shopify_attributes }}
      >
        <div class="gb-frame">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
                widths: '300, 400, 500, 600, 800',
                sizes: '(min-width: 1000px) 240px, 70vw',
                alt: tile_alt,
                loading: 'lazy',
                class: 'gb-frame__img'
            }}
          {% else %}
            <div class="gb-frame__ph">Add image<br>in the theme editor</div>
          {% endif %}
        </div>

        <div class="gb-rule"></div>

        <h3 class="gb-price">
          <span class="gb-price__under">Under </span><span class="gb-price__amt">{{ amount }}</span>
        </h3>

        {% if block.settings.description != blank %}
          <p class="gb-desc">{{ block.settings.description }}</p>
        {% else %}
          <p class="gb-desc"></p>
        {% endif %}

        <span class="gb-cta">
          <span class="gb-cta__label">Shop Now</span>
          <span class="gb-cta__arrow" aria-hidden="true">&#8594;</span>
        </span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .gb-shop-budget {
    /* Colour + type inherited from the homepage design system
       (gulmohar-home-fonts). Literal fallbacks only apply if this section
       ever renders outside the .gulmohar-home token context. */
    --gb-serif: var(--gh-serif, 'Cormorant Garamond', Georgia, 'Times New Roman', serif);
    --gb-sans: var(--gh-sans, 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    --gb-ink: var(--gh-ink, #1E1512);
    --gb-accent: var(--gh-burgundy, #4B1F23);
    --gb-muted: var(--gh-ink-62, rgba(30, 21, 18, 0.62));
    --gb-muted-strong: var(--gh-ink-70, rgba(30, 21, 18, 0.70));
    --gb-faint: var(--gh-ink-48, rgba(30, 21, 18, 0.48));
    --gb-rule: rgba(75, 31, 35, 0.7);
    --gb-frame-bg: var(--gh-cream, #F4F1EA);

    background: var(--gh-bg-main, #F2F0E9);
    padding: 104px 0;
    color: var(--gb-ink);
  }

  .gb-shop-budget * { box-sizing: border-box; }
  .gb-shop-budget a { color: inherit; text-decoration: none; }

  .gb-head {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 44px;
    text-align: center;
  }

  .gb-heading {
    font-family: var(--gb-serif);
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--gb-ink);
  }

  /* Subcopy matches the homepage's section lede: italic Cormorant, not sans. */
  .gb-sub {
    font-family: var(--gb-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(14px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--gb-muted);
    margin: 13px auto 0;
    max-width: 32rem;
  }

  /* Native horizontal scroll rail — no JS carousel. */
  .gb-rail {
    margin: 66px auto 0;
    max-width: 1080px;
    display: flex;
    gap: 48px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 44px;
    padding: 0 44px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gb-rail::-webkit-scrollbar { display: none; }

  .gb-tile {
    flex: 0 0 max(200px, calc((100% - 144px) / 4));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .gb-tile:focus-visible {
    outline: 1px solid var(--gb-accent);
    outline-offset: 10px;
  }

  .gb-frame {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--gb-frame-bg);
  }

  .gb-frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gb-frame__ph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px;
    font-family: var(--gb-sans);
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gb-faint);
    transition: transform 700ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gb-tile:hover .gb-frame > *,
  .gb-tile:focus-visible .gb-frame > * { transform: scale(1.025); }

  .gb-rule {
    margin-top: 26px;
    width: 24px;
    height: 1px;
    background: var(--gb-rule);
    transition: width 600ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gb-tile:hover .gb-rule,
  .gb-tile:focus-visible .gb-rule { width: 44px; }

  .gb-price {
    font-family: var(--gb-serif);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: 0.01em;
    margin: 16px 0 0;
  }

  .gb-price__under {
    font-size: 13px;
    color: var(--gb-muted);
  }

  .gb-price__amt { color: var(--gb-accent); }

  .gb-desc {
    font-family: var(--gb-sans);
    font-weight: 300;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--gb-muted);
    margin: 10px 0 0;
    max-width: 24ch;
    min-height: 40px;
  }

  .gb-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    white-space: nowrap;
    margin-top: 26px;
    font-family: var(--gb-sans);
    font-weight: 400;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gb-muted-strong);
    transition: color 300ms ease;
  }

  .gb-tile:hover .gb-cta,
  .gb-tile:focus-visible .gb-cta { color: var(--gb-accent); }

  .gb-tile:hover .gb-cta__label,
  .gb-tile:focus-visible .gb-cta__label {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .gb-cta__arrow {
    display: inline-block;
    transition: transform 300ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .gb-tile:hover .gb-cta__arrow,
  .gb-tile:focus-visible .gb-cta__arrow { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .gb-frame__img,
    .gb-frame__ph,
    .gb-cta__arrow,
    .gb-rule { transition: none !important; }

    .gb-tile:hover .gb-frame > *,
    .gb-tile:focus-visible .gb-frame > * { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Shop By Budget",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Budget."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Beautiful pieces, whatever you're looking to spend."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Budget Tier",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square product/lifestyle shot representative of this price tier. Real Shopify shop image — the section does not hardcode any photo."
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Price ceiling",
          "info": "Shown after a fixed \"Under\" prefix, e.g. ₹999.",
          "default": "₹999"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "One-line description",
          "default": "Simple pieces for every day."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The price-filtered collection this tier opens, e.g. /collections/all?max_price=999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Shop By Budget",
      "blocks": [
        { "type": "occasion", "settings": { "amount": "₹999", "description": "Simple pieces for every day.", "link": "/collections/all?max_price=999" } },
        { "type": "occasion", "settings": { "amount": "₹1,999", "description": "Delicate pieces with a little more presence.", "link": "/collections/all?max_price=1999" } },
        { "type": "occasion", "settings": { "amount": "₹2,999", "description": "Distinctive pieces for everyday expression.", "link": "/collections/all?max_price=2999" } },
        { "type": "occasion", "settings": { "amount": "₹3,999", "description": "Statement pieces for giving and keeping.", "link": "/collections/all?max_price=3999" } }
      ]
    }
  ]
}
{% endschema %}
