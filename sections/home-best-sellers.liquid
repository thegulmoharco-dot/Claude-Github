{%- doc -%}
  Best Sellers — an insertable homepage section only, built to the design
  handoff in design_handoff_best_sellers/. Eyebrow, heading, italic subcopy,
  a 3D coverflow carousel (dominant center card, two receded side cards,
  line+chevron arrows, dot pagination), then a "View all" link. Everything it
  renders is scoped under .gh-bestsellers / <best-sellers-carousel>: it does
  not touch the header, footer, navigation, any other homepage section, or
  the shared product-card system — see snippets/best-sellers-card.liquid.

  Reuses the existing homepage type/colour tokens and section rhythm from
  snippets/gulmohar-home-fonts.liquid (loaded once, by home-hero.liquid,
  earlier in section order) — no new global styles are introduced.

  Coverflow geometry (fixed values from the handoff, applied per card by
  assets/best-sellers-carousel.js): stage 960x440 desktop / 342x460 mobile,
  card 270px / 310px, center-to-center 300px / 400px, side cards
  scale 0.9 / rotateY 6deg / translateZ -60px / opacity 0.53 (desktop),
  transition 900ms cubic-bezier(0.22,0.61,0.36,1).
{%- enddoc -%}

{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign populated_count = 0
  for block in product_blocks
    if block.settings.product != blank
      assign populated_count = populated_count | plus: 1
    endif
  endfor
-%}

{% if populated_count > 0 %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section class="gulmohar-home gh-bestsellers color-{{ section.settings.color_scheme }}">
    <div class="gh-section-head">
      {% if section.settings.kicker != blank %}
        <div class="gh-kicker">{{ section.settings.kicker }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="gh-h2">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="gh-lede">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <best-sellers-carousel class="gh-bestsellers__carousel">
      <div class="gh-bestsellers__row">
        {% if populated_count > 1 %}
          <button type="button" class="gh-bestsellers__arrow gh-bestsellers__arrow--prev" data-bs-prev aria-label="Previous product">
            <svg viewBox="0 0 42 12" fill="none" aria-hidden="true">
              <path d="M13 2L5 6L13 10" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
              <line x1="5" y1="6" x2="40" y2="6" stroke="currentColor" stroke-width="1.1" vector-effect="non-scaling-stroke"></line>
            </svg>
          </button>
        {% endif %}

        <div class="gh-bestsellers__stage" data-bs-track>
          {% for block in product_blocks %}
            {% if block.settings.product != blank %}
              <div class="gh-bestsellers__slide" data-bs-slide {{ block.shopify_attributes }}>
                {% render 'best-sellers-card',
                  product: block.settings.product,
                  section_id: section.id,
                  block: block
                %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if populated_count > 1 %}
          <button type="button" class="gh-bestsellers__arrow gh-bestsellers__arrow--next" data-bs-next aria-label="Next product">
            <svg viewBox="0 0 42 12" fill="none" aria-hidden="true">
              <path d="M29 2L37 6L29 10" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
              <line x1="2" y1="6" x2="37" y2="6" stroke="currentColor" stroke-width="1.1" vector-effect="non-scaling-stroke"></line>
            </svg>
          </button>
        {% endif %}
      </div>

      {% if populated_count > 1 %}
        <div class="gh-bestsellers__dots" data-bs-dots>
          {% for i in (1..populated_count) %}
            <button
              type="button"
              class="gh-bestsellers__dot{% if forloop.first %} is-active{% endif %}"
              data-bs-dot
              aria-label="Go to product {{ forloop.index }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </best-sellers-carousel>

    {% if section.settings.view_all_label != blank %}
      <div class="gh-bestsellers__foot">
        <a href="{{ section.settings.view_all_link | default: '#' }}" class="gh-text-link">{{ section.settings.view_all_label }}</a>
      </div>
    {% endif %}
  </section>

  <script src="{{ 'best-sellers-carousel.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  /* Section background token pinned to the handoff's warm ivory so the
     section reads on-brand regardless of the assigned colour scheme's base. */
  .gh-bestsellers {
    padding: clamp(56px, 9vw, 104px) clamp(20px, 4vw, 44px) clamp(48px, 8vw, 100px);
    --bsc-card-w: 270px;
  }

  .gh-bestsellers__carousel { display: block; }

  .gh-bestsellers__row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 64px);
  }

  /* Stage — cards are absolutely positioned inside it and driven by
     assets/best-sellers-carousel.js. overflow:hidden clips the receded /
     off-stage neighbours. The height is a safe fallback that fits a
     full-scale card with a two-line title and a two-line (compare-at + sale)
     price; best-sellers-carousel.js then sets it precisely to the tallest
     card so a discounted centre card's sale price is never clipped. */
  .gh-bestsellers__stage {
    position: relative;
    width: 100%;
    max-width: 960px;
    height: 460px;
    overflow: hidden;
    perspective: 1500px;
    touch-action: pan-y;
  }

  .gh-bestsellers__slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--bsc-card-w);
    margin-left: calc(var(--bsc-card-w) / -2);
    transform-origin: center top;
    backface-visibility: hidden;
    opacity: 0;
  }

  /* No-JS / pre-hydration fallback: the first card reads correctly and
     centered before best-sellers-carousel.js runs its own render pass. */
  .gh-bestsellers__slide:first-child {
    opacity: 1;
    z-index: 3;
  }

  /* Editorial arrows: thin line + chevron, no box/border/shadow, sitting
     outside the stage and vertically aligned to the product photo's centre
     (~147px down, not the full card centre). */
  .gh-bestsellers__arrow {
    flex: none;
    margin-top: 147px;
    padding: 16px 10px;
    border: 0;
    background: none;
    color: rgba(30, 21, 18, 0.42);
    cursor: pointer;
    display: flex;
    align-items: center;
    transition: color 200ms ease, transform 200ms ease, opacity 200ms ease;
  }

  .gh-bestsellers__arrow svg { width: 42px; height: 12px; display: block; }

  .gh-bestsellers__arrow:hover { color: var(--gh-burgundy); opacity: 0.9; }
  .gh-bestsellers__arrow--prev:hover { transform: translateX(-4px); }
  .gh-bestsellers__arrow--next:hover { transform: translateX(4px); }

  /* Dot pagination — one per product, below the stage, above the CTA. */
  .gh-bestsellers__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 32px;
  }

  .gh-bestsellers__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(30, 21, 18, 0.28);
    cursor: pointer;
    transition: background 300ms ease, width 300ms ease, height 300ms ease;
  }

  .gh-bestsellers__dot.is-active {
    width: 7px;
    height: 7px;
    background: var(--gh-burgundy);
  }

  .gh-bestsellers__foot { text-align: center; margin-top: 44px; }

  @media screen and (max-width: 749px) {
    .gh-bestsellers { --bsc-card-w: 310px; }

    .gh-bestsellers__row { gap: 0; }

    .gh-bestsellers__stage { max-width: 342px; height: 510px; }

    /* Mobile arrows leave the flex flow and sit in the section's side gutter,
       over the stage's empty (off-stage-neighbour) edges — never over the
       centre card — vertically aligned to the mobile photo centre (~194px). */
    .gh-bestsellers__arrow {
      position: absolute;
      z-index: 5;
      top: 194px;
      margin-top: 0;
      transform: translateY(-50%);
      padding: 10px;
      color: rgba(30, 21, 18, 0.35);
    }

    .gh-bestsellers__arrow svg { width: 16px; height: 6px; }

    .gh-bestsellers__arrow--prev { left: -4px; }
    .gh-bestsellers__arrow--next { right: -4px; }
    .gh-bestsellers__arrow--prev:hover,
    .gh-bestsellers__arrow--next:hover { transform: translateY(-50%); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home Best Sellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "— Best Sellers —"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em></em> for the burgundy italic accent.",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The pieces our customers keep coming back to."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" link label",
      "default": "View All Jewellery →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-gulmohar-sand"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "badge",
          "label": "Badge",
          "info": "Reserved. The Best Sellers card follows the design handoff and shows only the material chip, so this is not rendered.",
          "options": [
            { "value": "", "label": "None" },
            { "value": "New", "label": "New" },
            { "value": "Bestseller", "label": "Bestseller" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Best Sellers",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
